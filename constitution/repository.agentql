repository AgentVocabulary {

  identity {
    type canonical_semantic_primitive_repository
    authoritative true
    evolvable true
  }

  maturity {

    stage sandbox

    criteria {

      semantic_stability required
      governance_maturity required
      enforcement_maturity required
      federation_readiness required
      sovereignty_readiness required
      operational_robustness required
      security_trust required
      evolution_safety required
      ecosystem_adoption required
      explainability required
    }

    promotion {

      sandbox_to_incubating {
        requires [
          semantic_validation,
          governance_enforcement,
          auditability,
          traceability,
          repository_boundary_enforcement
        ]
      }

      incubating_to_graduated {
        requires [
          interoperability,
          backward_compatibility,
          federation_compatibility,
          operational_robustness,
          ecosystem_adoption,
          security_validation
        ]
      }
    }
  }

  golden_path {

    governance mandatory

    mandatory_artifacts [
      agent.agentql,
      constitution/repository.agentql,
      .github/workflows/semantic-governance.yml
    ]

    mandatory_controls [
      semantic_validation,
      maturity_validation,
      governance_validation,
      traceability_validation,
      auditability_validation
    ]

    github_enforcement {
      protected_branches mandatory
      signed_commits mandatory
      pull_request_reviews mandatory
      required_checks mandatory
      codeowners mandatory
    }
  }

  responsibility {

    owns [
      primitive_definitions,
      semantic_terms,
      primitive_classifications,
      primitive_attributes,
      primitive_evolution_semantics
    ]
  }

  prohibits [
    execution_semantics,
    runtime_logic,
    orchestration,
    middleware_definitions,
    governance_enforcement,
    workflow_execution,
    infrastructure_bindings,
    ontology_relationship_resolution
  ]

  boundaries {

    grammar AgentGrammar
    governance AgentRules
    ontology AgentOntology
    execution AgentQL
    constitution AgentConstitution
  }

  structure {

    root vocab/

    domains [
      cognition,
      governance,
      civilization,
      execution,
      trust,
      temporal
    ]
  }
}

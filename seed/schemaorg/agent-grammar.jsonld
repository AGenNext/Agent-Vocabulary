{
  "@context": {
    "schema": "https://schema.org/",
    "agx": "https://agennext.dev/vocab#",
    "name": "schema:name",
    "description": "schema:description",
    "termCode": "schema:termCode",
    "hasDefinedTerm": "schema:hasDefinedTerm",
    "isPartOf": "schema:isPartOf",
    "subjectOf": "schema:subjectOf",
    "about": "schema:about",
    "text": "schema:text",
    "position": "schema:position"
  },
  "@type": "schema:DefinedTermSet",
  "@id": "agx:AgentGrammar",
  "name": "AGenNext Agent Grammar",
  "description": "Machine-loadable rules for how AGenNext vocabulary words can be combined into valid agent instructions.",
  "hasDefinedTerm": [
    {
      "@type": "schema:DefinedTerm",
      "@id": "agx:Rule-Prompt-Is-CreativeWork",
      "name": "Prompt is CreativeWork",
      "termCode": "agx:Rule-Prompt-Is-CreativeWork",
      "description": "A Prompt instance MUST be represented as schema:CreativeWork. A schema:DefinedTerm named Prompt only defines the vocabulary word."
    },
    {
      "@type": "schema:DefinedTerm",
      "@id": "agx:Rule-Prompt-Contains-Instructions",
      "name": "Prompt contains instructions",
      "termCode": "agx:Rule-Prompt-Contains-Instructions",
      "description": "A Prompt CreativeWork SHOULD contain instruction text in schema:text or an equivalent content field."
    },
    {
      "@type": "schema:DefinedTerm",
      "@id": "agx:Rule-Prompt-Describes-Actions",
      "name": "Prompt describes Actions",
      "termCode": "agx:Rule-Prompt-Describes-Actions",
      "description": "A Prompt CreativeWork MAY describe one or more schema:Action objects using schema:potentialAction."
    },
    {
      "@type": "schema:DefinedTerm",
      "@id": "agx:Rule-RepeatAction-Repeats-Actions",
      "name": "RepeatAction repeats Actions",
      "termCode": "agx:Rule-RepeatAction-Repeats-Actions",
      "description": "A RepeatAction is a schema:Action command whose object is a set or ordered list of schema:Action objects to repeat."
    },
    {
      "@type": "schema:DefinedTerm",
      "@id": "agx:Rule-PromptTemplate-Uses-Variables",
      "name": "PromptTemplate uses Variables",
      "termCode": "agx:Rule-PromptTemplate-Uses-Variables",
      "description": "A PromptTemplate CreativeWork MAY contain replaceable Variable values represented as schema:PropertyValue."
    },
    {
      "@type": "schema:DefinedTerm",
      "@id": "agx:Rule-Action-Produces-Result",
      "name": "Action produces Result",
      "termCode": "agx:Rule-Action-Produces-Result",
      "description": "A schema:Action MAY produce a Result using schema:result."
    }
  ]
}
